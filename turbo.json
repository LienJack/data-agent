{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "@data-agent/contracts#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@data-agent/text2sql#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:research": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:architecture": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:providers": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:security": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
