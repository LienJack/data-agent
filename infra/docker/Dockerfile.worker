# =============================================================================
# Worker App — Node.js durable worker
# Target: production-like OCI image for compose.yaml / hosted deployment
# =============================================================================
ARG NODE_VERSION=24-alpine
ARG PNPM_VERSION=10.33.2

# ---------- Stage 1: base (shared toolchain) ----------
FROM node:${NODE_VERSION} AS base
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

# ---------- Stage 2: dependencies ----------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/ agent-runtime/ contracts/ evals/ platform/ research/ semantic/ text2sql/ ./packages/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline

# ---------- Stage 3: build ----------
FROM deps AS builder
COPY tsconfig.base.json ./
COPY apps/worker/tsconfig.json apps/worker/tsconfig.build.json apps/worker/ 2>/dev/null || true
COPY apps/worker/src apps/worker/src
RUN pnpm --filter @data-agent/worker build

# ---------- Stage 4: production runner ----------
FROM node:${NODE_VERSION} AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 worker && \
    adduser --system --uid 1001 worker

COPY --from=builder --chown=worker:worker /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=worker:worker /app/packages ./packages
COPY --from=builder --chown=worker:worker /app/node_modules/.pnpm ./node_modules/.pnpm
COPY --from=builder --chown=worker:worker /app/package.json ./package.json

# Recreate the pnpm workspace links so the worker can resolve its workspace deps
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate && \
    pnpm install --frozen-lockfile --prefer-offline --prod

USER worker

CMD ["node", "apps/worker/dist/index.js"]
