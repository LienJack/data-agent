{
  "schema_version": "statistical-operator-manifest@2.0.0",
  "registry_id": "data-agent-governed-statistics@1",
  "operators": [
    {
      "operator_id": "multiple-testing.bh-fdr@1",
      "description_zh": "对一个明确检验族执行 Benjamini-Hochberg FDR 校正。",
      "implementation": {
        "module": "data_agent_stats.multiple_testing",
        "symbol": "bh_fdr"
      },
      "runtime_profile": "CORE_ANALYSIS",
      "batching": {
        "mode": "LABELED_BATCH",
        "max_items": 5000
      },
      "inputs": [
        {
          "name": "tests",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 5000,
          "record_shape": {
            "label": "NON_EMPTY_STRING",
            "p_value": "UNIT_INTERVAL_NUMBER"
          },
          "record_example": {
            "label": "hypothesis_a",
            "p_value": 0.03
          },
          "limits": {}
        }
      ],
      "parameters": [
        {
          "name": "alpha",
          "kind": "FINITE_NUMBER",
          "required": false,
          "default": 0.05,
          "minimum_exclusive": 0,
          "maximum_inclusive": 1
        },
        {
          "name": "method",
          "kind": "ENUM",
          "required": false,
          "default": "bh",
          "allowed_values": ["bh"]
        }
      ],
      "outputs": {
        "collection": "tests",
        "label_fields": ["label"],
        "value_fields": ["adjusted_p_value", "rejected"],
        "evidence_fields": ["family_size", "alpha", "method"]
      },
      "applicability_checks": [
        "NON_EMPTY_FAMILY",
        "UNIQUE_LABELS",
        "FINITE_P_VALUES_IN_UNIT_INTERVAL"
      ],
      "limitations": [
        "FAMILY_DEFINITION_MUST_BE_PREDECLARED",
        "DEPENDENCE_STRUCTURE_NOT_VERIFIED"
      ]
    },
    {
      "operator_id": "robust-trend.theil-sen-slope@1",
      "description_zh": "按显式时间序计算 Theil-Sen 稳健斜率。",
      "implementation": {
        "module": "data_agent_stats.robust_trend",
        "symbol": "theil_sen_slope"
      },
      "runtime_profile": "CORE_ANALYSIS",
      "batching": {
        "mode": "LABELED_BATCH",
        "max_items": 512
      },
      "inputs": [
        {
          "name": "series",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 512,
          "record_shape": {
            "label": "NON_EMPTY_STRING",
            "x": "STRICT_ORDER_ARRAY",
            "y": "FINITE_NUMBER_ARRAY"
          },
          "record_example": {
            "label": "series_a",
            "x": [0, 1, 2],
            "y": [1.0, 2.0, 3.5]
          },
          "limits": {
            "max_points_per_record": 512
          }
        }
      ],
      "parameters": [],
      "outputs": {
        "collection": "series",
        "label_fields": ["label"],
        "value_fields": ["slope"],
        "evidence_fields": ["sample_size", "pair_count"]
      },
      "applicability_checks": [
        "MINIMUM_TWO_FINITE_OBSERVATIONS",
        "STRICTLY_ORDERED_X",
        "AT_LEAST_TWO_DISTINCT_X"
      ],
      "limitations": ["SLOPE_UNIT_DEPENDS_ON_DECLARED_X_SCALE"]
    },
    {
      "operator_id": "trend.mann-kendall-original@1",
      "description_zh": "执行带 ties 方差修正和连续性修正的 original Mann-Kendall 趋势检验。",
      "implementation": {
        "module": "data_agent_stats.robust_trend",
        "symbol": "mann_kendall_original"
      },
      "runtime_profile": "CORE_ANALYSIS",
      "batching": {
        "mode": "LABELED_BATCH",
        "max_items": 5000
      },
      "inputs": [
        {
          "name": "series",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 5000,
          "record_shape": {
            "label": "NON_EMPTY_STRING",
            "order": "STRICT_ORDER_ARRAY",
            "value": "FINITE_NUMBER_ARRAY"
          },
          "record_example": {
            "label": "series_a",
            "order": ["2024-01", "2024-02", "2024-03"],
            "value": [1.0, 2.0, 3.0]
          },
          "limits": {
            "max_points_per_record": 5000
          }
        }
      ],
      "parameters": [
        {
          "name": "alpha",
          "kind": "FINITE_NUMBER",
          "required": false,
          "default": 0.05,
          "minimum_exclusive": 0,
          "maximum_inclusive": 1
        },
        {
          "name": "continuity_correction",
          "kind": "BOOLEAN",
          "required": false,
          "default": true
        },
        {
          "name": "variant",
          "kind": "ENUM",
          "required": false,
          "default": "original",
          "allowed_values": ["original"]
        }
      ],
      "outputs": {
        "collection": "series",
        "label_fields": ["label"],
        "value_fields": ["s", "variance_s", "z", "p_value", "tau", "trend", "rejected"],
        "evidence_fields": ["sample_size", "tie_group_count", "alpha", "variant"]
      },
      "applicability_checks": [
        "MINIMUM_THREE_FINITE_OBSERVATIONS",
        "UNIQUE_ORDER_WITHIN_LABEL"
      ],
      "limitations": [
        "SERIAL_CORRELATION_NOT_CORRECTED",
        "SEASONALITY_NOT_CORRECTED"
      ]
    },
    {
      "operator_id": "regression.ols-hac@1",
      "description_zh": "执行 OLS 并使用固定 Newey-West HAC 协方差配置返回系数和显著性证据。",
      "implementation": {
        "module": "data_agent_stats.regression",
        "symbol": "ols_hac"
      },
      "runtime_profile": "ML_DIAGNOSTIC",
      "batching": {
        "mode": "LABELED_BATCH",
        "max_items": 5000
      },
      "inputs": [
        {
          "name": "models",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 1024,
          "record_shape": {
            "label": "NON_EMPTY_STRING",
            "row_order": "STRICT_ORDER_ARRAY",
            "outcome": "FINITE_NUMBER_ARRAY",
            "predictors": "NAMED_FINITE_NUMBER_ARRAY_MAP"
          },
          "record_example": {
            "label": "model_a",
            "row_order": [0, 1, 2, 3, 4, 5],
            "outcome": [1.0, 2.2, 2.8, 4.1, 5.2, 5.9],
            "predictors": {
              "exposure": [0.0, 1.0, 0.0, 1.0, 0.0, 1.0],
              "control": [1.0, 1.5, 2.0, 2.2, 3.0, 3.4]
            }
          },
          "limits": {
            "max_rows_per_record": 100000,
            "max_named_fields_per_record": 64
          }
        }
      ],
      "parameters": [
        {
          "name": "maxlags",
          "kind": "NON_NEGATIVE_INTEGER",
          "required": true,
          "maximum_inclusive": 120
        },
        {
          "name": "kernel",
          "kind": "ENUM",
          "required": false,
          "default": "bartlett",
          "allowed_values": ["bartlett"]
        },
        {
          "name": "use_correction",
          "kind": "BOOLEAN",
          "required": false,
          "default": true
        },
        {
          "name": "use_t",
          "kind": "BOOLEAN",
          "required": false,
          "default": false
        },
        {
          "name": "add_intercept",
          "kind": "BOOLEAN",
          "required": false,
          "default": true
        }
      ],
      "outputs": {
        "collection": "coefficients",
        "label_fields": ["label", "term"],
        "value_fields": ["coefficient", "standard_error", "statistic", "p_value"],
        "evidence_fields": ["sample_size", "rank", "maxlags", "kernel", "use_correction", "use_t"]
      },
      "applicability_checks": [
        "FINITE_COMPLETE_CASES",
        "STRICT_ROW_ORDER",
        "FULL_COLUMN_RANK",
        "SAMPLE_EXCEEDS_PARAMETER_COUNT",
        "MAXLAGS_BELOW_SAMPLE_SIZE"
      ],
      "limitations": ["ASSOCIATION_NOT_CAUSATION", "ORDERING_DEFINES_HAC_DEPENDENCE"]
    },
    {
      "operator_id": "regression.binomial-logit-wald@1",
      "description_zh": "执行二项 Logit GLM，并返回 Wald 系数、标准误和收敛证据。",
      "implementation": {
        "module": "data_agent_stats.regression",
        "symbol": "binomial_logit_wald"
      },
      "runtime_profile": "ML_DIAGNOSTIC",
      "batching": {
        "mode": "LABELED_BATCH",
        "max_items": 1024
      },
      "inputs": [
        {
          "name": "models",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 1024,
          "record_shape": {
            "label": "NON_EMPTY_STRING",
            "outcome": "BINARY_NUMBER_ARRAY",
            "predictors": "NAMED_FINITE_NUMBER_ARRAY_MAP"
          },
          "record_example": {
            "label": "model_a",
            "outcome": [0, 1, 0, 1, 0, 1],
            "predictors": {
              "delay_minutes": [5.0, 15.0, 8.0, 25.0, 12.0, 30.0],
              "order_amount": [80.0, 120.0, 95.0, 150.0, 110.0, 170.0]
            }
          },
          "limits": {
            "max_rows_per_record": 100000,
            "max_named_fields_per_record": 64
          }
        }
      ],
      "parameters": [
        {
          "name": "add_intercept",
          "kind": "BOOLEAN",
          "required": false,
          "default": true
        },
        {
          "name": "max_iterations",
          "kind": "POSITIVE_INTEGER",
          "required": false,
          "default": 100,
          "maximum_inclusive": 1000
        },
        {
          "name": "tolerance",
          "kind": "FINITE_NUMBER",
          "required": false,
          "default": 1e-08,
          "minimum_exclusive": 0,
          "maximum_inclusive": 0.01
        }
      ],
      "outputs": {
        "collection": "coefficients",
        "label_fields": ["label", "term"],
        "value_fields": ["coefficient", "standard_error", "wald_z", "p_value"],
        "evidence_fields": ["sample_size", "rank", "converged", "iterations"]
      },
      "applicability_checks": [
        "BINARY_OUTCOME",
        "FINITE_COMPLETE_CASES",
        "BOTH_OUTCOME_CLASSES_PRESENT",
        "FULL_COLUMN_RANK",
        "NO_COMPLETE_SEPARATION",
        "CONVERGED"
      ],
      "limitations": ["ASSOCIATION_NOT_CAUSATION"]
    },
    {
      "operator_id": "decomposition.product-shapley-exact@1",
      "description_zh": "对乘积恒等式执行全排列精确 Shapley 分解并验证加总闭合。",
      "implementation": {
        "module": "data_agent_stats.decomposition",
        "symbol": "product_shapley_exact"
      },
      "runtime_profile": "CORE_ANALYSIS",
      "batching": {
        "mode": "LABELED_BATCH",
        "max_items": 1024
      },
      "inputs": [
        {
          "name": "comparisons",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 1024,
          "record_shape": {
            "label": "NON_EMPTY_STRING",
            "baseline_factors": "NAMED_FINITE_NUMBER_MAP",
            "current_factors": "NAMED_FINITE_NUMBER_MAP"
          },
          "record_example": {
            "label": "comparison_a",
            "baseline_factors": {
              "buyers": 100.0,
              "frequency": 1.2,
              "aov": 80.0
            },
            "current_factors": {
              "buyers": 90.0,
              "frequency": 1.1,
              "aov": 75.0
            }
          },
          "limits": {
            "max_named_fields_per_record": 8
          }
        }
      ],
      "parameters": [
        {
          "name": "mode",
          "kind": "ENUM",
          "required": false,
          "default": "exact",
          "allowed_values": ["exact"]
        },
        {
          "name": "max_factors",
          "kind": "POSITIVE_INTEGER",
          "required": false,
          "default": 8,
          "maximum_inclusive": 8
        },
        {
          "name": "closure_tolerance",
          "kind": "FINITE_NUMBER",
          "required": false,
          "default": 1e-09,
          "minimum_inclusive": 0,
          "maximum_inclusive": 0.000001
        }
      ],
      "outputs": {
        "collection": "contributions",
        "label_fields": ["label", "factor"],
        "value_fields": ["contribution"],
        "evidence_fields": ["baseline_product", "current_product", "delta", "closure_error", "permutation_count"]
      },
      "applicability_checks": [
        "SAME_UNIQUE_FACTOR_SET",
        "FINITE_FACTOR_VALUES",
        "FACTOR_COUNT_WITHIN_EXACT_LIMIT",
        "EXACT_CLOSURE"
      ],
      "limitations": ["PRODUCT_IDENTITY_REQUIRED", "APPROXIMATE_MODE_NOT_SUPPORTED"]
    },
    {
      "operator_id": "descriptive.inventory-damage-priority@1",
      "description_zh": "按商品汇总库存损坏序列，以品类销量 P75 和受治理趋势检验结果生成完整排查候选集。",
      "implementation": {
        "module": "data_agent_stats.inventory",
        "symbol": "inventory_damage_priority"
      },
      "runtime_profile": "CORE_ANALYSIS",
      "batching": {
        "mode": "LABELED_BATCH",
        "max_items": 5000
      },
      "inputs": [
        {
          "name": "inventory_rows",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 5000,
          "record_shape": {
            "product_id": "NON_EMPTY_STRING",
            "product_name": "NON_EMPTY_STRING",
            "category": "NON_EMPTY_STRING",
            "month": "MONTH_KEY",
            "sales_quantity": "NON_NEGATIVE_FINITE_NUMBER",
            "stock_received": "NON_NEGATIVE_FINITE_NUMBER",
            "damaged_stock": "NON_NEGATIVE_FINITE_NUMBER"
          },
          "record_example": {
            "product_id": "product_a",
            "product_name": "Product A",
            "category": "grocery",
            "month": "2024-01",
            "sales_quantity": 100.0,
            "stock_received": 80.0,
            "damaged_stock": 2.0
          },
          "limits": {}
        },
        {
          "name": "theil_sen",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 512,
          "record_shape": {
            "label": "NON_EMPTY_STRING",
            "slope": "FINITE_NUMBER"
          },
          "record_example": {
            "label": "product_a",
            "slope": 0.01
          },
          "limits": {}
        },
        {
          "name": "mann_kendall",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 512,
          "record_shape": {
            "label": "NON_EMPTY_STRING",
            "p_value": "UNIT_INTERVAL_NUMBER"
          },
          "record_example": {
            "label": "product_a",
            "p_value": 0.01
          },
          "limits": {}
        },
        {
          "name": "bh_fdr",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 512,
          "record_shape": {
            "label": "NON_EMPTY_STRING",
            "adjusted_p_value": "UNIT_INTERVAL_NUMBER"
          },
          "record_example": {
            "label": "product_a",
            "adjusted_p_value": 0.02
          },
          "limits": {}
        }
      ],
      "parameters": [
        {
          "name": "alpha",
          "kind": "FINITE_NUMBER",
          "required": false,
          "default": 0.05,
          "minimum_exclusive": 0,
          "maximum_inclusive": 1
        },
        {
          "name": "category_sales_percentile",
          "kind": "FINITE_NUMBER",
          "required": false,
          "default": 0.75,
          "minimum_inclusive": 0.75,
          "maximum_inclusive": 0.75
        }
      ],
      "outputs": {
        "collection": "products",
        "label_fields": ["product_id"],
        "value_fields": ["product_name", "category", "sales_quantity", "category_sales_p75", "theil_sen_slope", "last3_damage_rate", "previous9_damage_rate", "raw_p_value", "bh_q_value", "status"],
        "evidence_fields": ["product_count", "candidate_count", "category_sales_percentile", "selection_rule"]
      },
      "applicability_checks": [
        "EXACT_PRODUCT_LABEL_CLOSURE",
        "TWELVE_UNIQUE_MONTHS_PER_PRODUCT",
        "CONSISTENT_PRODUCT_METADATA",
        "LINEAR_CATEGORY_PERCENTILE",
        "COMPLETE_CANDIDATE_SET"
      ],
      "limitations": [
        "DESCRIPTIVE_SCREENING_NOT_CAUSAL",
        "INPUT_SERIES_MUST_COVER_ALL_PRODUCTS"
      ]
    },
    {
      "operator_id": "cohort.registration-retention-m0-m6@2",
      "description_zh": "按注册月形成唯一新客 cohort，计算 M0 至 M6 下单、消费、配送和反馈留存证据。",
      "implementation": {
        "module": "data_agent_stats.cohort",
        "symbol": "registration_retention_m0_m6"
      },
      "runtime_profile": "CORE_ANALYSIS",
      "batching": {
        "mode": "LABELED_BATCH",
        "max_items": 5000
      },
      "inputs": [
        {
          "name": "customers",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 100000,
          "record_shape": {
            "customer_id": "NON_EMPTY_STRING",
            "registration_date": "DATE_KEY",
            "customer_type": "NON_EMPTY_STRING"
          },
          "record_example": {
            "customer_id": "customer_a",
            "registration_date": "2024-01-15",
            "customer_type": "new"
          },
          "limits": {}
        },
        {
          "name": "events",
          "container": "RECORD_ARRAY",
          "min_items": 0,
          "max_items": 500000,
          "record_shape": {
            "customer_id": "NON_EMPTY_STRING",
            "event_date": "DATE_KEY",
            "order_id": "NON_EMPTY_STRING",
            "revenue": "NON_NEGATIVE_FINITE_NUMBER",
            "delivery_minutes": "NULLABLE_NON_NEGATIVE_FINITE_NUMBER",
            "rating": "NULLABLE_RATING_1_TO_5"
          },
          "record_example": {
            "customer_id": "customer_a",
            "event_date": "2024-01-20",
            "order_id": "order_a",
            "revenue": 100.0,
            "delivery_minutes": 30.0,
            "rating": 5.0
          },
          "limits": {}
        },
        {
          "name": "observation",
          "container": "RECORD_ARRAY",
          "min_items": 1,
          "max_items": 1,
          "record_shape": {
            "observation_end_month": "MONTH_KEY",
            "invalid_delivery_event_count": "NON_NEGATIVE_FINITE_NUMBER"
          },
          "record_example": {
            "observation_end_month": "2024-12",
            "invalid_delivery_event_count": 0
          },
          "limits": {}
        }
      ],
      "parameters": [
        {
          "name": "horizon_months",
          "kind": "ENUM_INTEGER",
          "required": false,
          "default": 6,
          "allowed_values": [6]
        },
        {
          "name": "pre_registration_policy",
          "kind": "ENUM",
          "required": true,
          "allowed_values": ["hold_primary", "exclude_sensitivity"]
        },
        {
          "name": "duplicate_customer_policy",
          "kind": "ENUM",
          "required": false,
          "default": "reject",
          "allowed_values": ["reject"]
        }
      ],
      "outputs": {
        "collection": "cohort_periods",
        "label_fields": ["registration_month", "customer_type", "month_index"],
        "value_fields": ["eligible_customers", "active_customers", "retention_rate", "repeat_customers", "repeat_purchase_rate", "order_count", "revenue", "average_spend", "average_delivery_minutes", "average_rating"],
        "evidence_fields": ["cohort_size", "matured", "pre_registration_event_count", "orphan_event_count", "invalid_delivery_event_count", "data_quality_status"]
      },
      "applicability_checks": [
        "UNIQUE_CUSTOMER_REGISTRATION",
        "VALID_DATE_AND_MONTH_KEYS",
        "M0_TO_M6_COMPLETE_GRID",
        "NON_NEGATIVE_REVENUE",
        "INVALID_DELIVERY_EVENTS_DISCLOSED_AND_EXCLUDED",
        "PRE_REGISTRATION_EVENTS_DISCLOSED",
        "MATURED_DENOMINATOR_ONLY"
      ],
      "limitations": [
        "PRIMARY_HOLD_ON_PRE_REGISTRATION_EVENTS",
        "SENSITIVITY_MUST_RETAIN_QUALITY_COUNTS",
        "ORPHAN_EVENTS_EXCLUDED",
        "INVALID_DELIVERY_EVENTS_EXCLUDED"
      ]
    }
  ]
}
