{
  "name": "data-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "benchmark:ecommerce:acceptance": "pnpm --filter @data-agent/web ecommerce:agent:acceptance",
    "dev": "tsx scripts/local-dev-runtime.ts dev",
    "dev:build": "tsx scripts/local-dev-runtime.ts build",
    "dev:infra": "tsx scripts/local-dev-runtime.ts infra",
    "dev:migrate": "tsx scripts/local-dev-runtime.ts migrate",
    "dev:check": "tsx scripts/local-dev-runtime.ts check",
    "dev:apps": "tsx scripts/local-dev-runtime.ts apps",
    "dev:web": "tsx scripts/local-dev-runtime.ts web",
    "dev:worker": "tsx scripts/local-dev-runtime.ts worker",
    "dev:indexer": "tsx scripts/local-dev-runtime.ts indexer",
    "dev:semantic-authoring": "tsx scripts/local-dev-runtime.ts semantic-authoring",
    "docker:migrate": "tsx scripts/local-dev-runtime.ts docker-migrate",
    "docker:up": "tsx scripts/local-dev-runtime.ts docker-up",
    "docker:down": "tsx scripts/local-dev-runtime.ts docker-down",
    "test:dev-runtime": "vitest run tests/local-dev-runtime.spec.ts",
    "build": "turbo run build",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck && pnpm typecheck:u6-c2",
    "typecheck:u6-c2": "tsc -p tsconfig.u6-c2.json",
    "test:unit": "tsx scripts/run-workspace-gate.ts test:unit",
    "test:contract": "tsx scripts/run-workspace-gate.ts test:contract",
    "test:research": "tsx scripts/run-workspace-gate.ts test:research",
    "test:architecture": "tsx scripts/run-workspace-gate.ts test:architecture",
    "test:providers": "tsx scripts/run-workspace-gate.ts test:providers",
    "test:integration": "tsx scripts/run-integration-gate.ts",
    "test:tenancy": "pnpm --filter @data-agent/platform test:tenancy && ./infra/supabase/test-support/run-postgres-smoke.sh && ./scripts/test-platform-integration.sh",
    "test:sandbox": "./scripts/test-sandbox.sh",
    "test:e2e": "tsx scripts/pending-gate.ts test:e2e U8",
    "eval:smoke": "tsx scripts/eval-smoke.ts",
    "benchmark:install": "tsx scripts/install-benchmark.ts",
    "benchmark:smoke": "tsx scripts/benchmark-smoke.ts",
    "benchmark:status": "tsx scripts/install-benchmark.ts status",
    "benchmark:ecommerce:build": "tsx scripts/build-agenticdatabench-ecommerce-bundle.ts",
    "benchmark:ecommerce:verify": "tsx scripts/verify-agenticdatabench-ecommerce-bundle.ts",
    "benchmark:ecommerce:semantic": "tsx scripts/build-ecommerce-semantic-bundle.ts",
    "benchmark:ecommerce:suite": "tsx scripts/build-ecommerce-production-suite.ts",
    "sandbox:analysis:attest": "tsx scripts/verify-opensandbox-analysis-attestation.ts",
    "sandbox:analysis:probe": "tsx scripts/verify-opensandbox-analysis-runtime.ts",
    "sandbox:analysis:unique": "tsx scripts/verify-analysis-runtime-uniqueness.ts",
    "bootstrap:superadmin": "tsx apps/web/src/cli/bootstrap-superadmin.ts",
    "bootstrap:ecommerce-demo": "tsx apps/web/src/cli/bootstrap-ecommerce-demo.ts",
    "falcon:bundle:verify": "tsx scripts/falcon.ts bundle:verify",
    "falcon:workspace:attach": "tsx scripts/falcon.ts workspace:attach",
    "falcon:workspace:verify": "tsx scripts/falcon.ts workspace:verify",
    "falcon:semantic:publish": "tsx scripts/falcon.ts semantic:publish",
    "falcon:semantic:verify": "tsx scripts/falcon.ts semantic:verify",
    "falcon:demo:smoke": "tsx scripts/falcon.ts demo:smoke",
    "falcon:eval:batch": "tsx scripts/falcon.ts eval:batch",
    "falcon:submission": "tsx scripts/falcon.ts submission",
    "falcon:agent-gate": "pnpm --filter @data-agent/worker falcon:team",
    "falcon:agent-final": "pnpm --filter @data-agent/worker falcon:final",
    "falcon24:analysis:gate": "pnpm --filter @data-agent/worker falcon24:analysis:gate",
    "deepseek:analysis:strict-probe": "pnpm --filter @data-agent/worker deepseek:analysis:strict-probe",
    "falcon24:analysis:control": "pnpm --filter @data-agent/web falcon24:analysis:control",
    "dev:admin-sync": "tsx apps/web/src/cli/local-superadmin-sync.ts",
    "dev:research-authority": "tsx scripts/provision-research-analysis-authority.ts",
    "test:security": "pnpm --filter @data-agent/agent-runtime test:security && pnpm --filter @data-agent/platform test:security && ./infra/supabase/test-support/run-postgres-smoke.sh && ./scripts/test-platform-integration.sh",
    "test:deploy:docker": "./scripts/test-deploy-docker.sh",
    "test:deploy:hosted": "tsx scripts/pending-gate.ts test:deploy:hosted U9",
    "capability:probe": "tsx scripts/capability-probe.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "cleanup:legacy-attribution": "tsx scripts/legacy-attribution-cleanup.ts",
    "generate:statistical-operators": "tsx scripts/generate-statistical-operator-contracts.ts",
    "check:statistical-operators": "tsx scripts/generate-statistical-operator-contracts.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "turbo": "2.10.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "dependencies": {
    "pg": "8.22.0"
  }
}
