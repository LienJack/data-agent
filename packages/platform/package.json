{
  "name": "@data-agent/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./artifact-workspace-service": {
      "types": "./dist/artifacts/artifact-workspace-service.d.ts",
      "import": "./dist/artifacts/artifact-workspace-service.js"
    },
    "./datasource-adapters": {
      "types": "./dist/datasources/adapters/index.d.ts",
      "import": "./dist/datasources/adapters/index.js"
    },
    "./runtime-config": {
      "types": "./dist/runtime-config/index.d.ts",
      "import": "./dist/runtime-config/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run test --exclude 'test/integration/**'",
    "test:contract": "vitest run test/contract",
    "test:integration": "vitest run test/integration --passWithNoTests=false",
    "test:tenancy": "vitest run test/tenancy test/storage test/cache test/lifecycle --passWithNoTests=false",
    "test:security": "vitest run test/datasources test/secrets test/tenancy test/storage test/cache --passWithNoTests=false"
  },
  "dependencies": {
    "@clickhouse/client": "1.20.0",
    "@data-agent/contracts": "workspace:*",
    "@duckdb/node-api": "1.5.2-r.2",
    "@next/env": "16.3.0",
    "@upstash/redis": "1.38.0",
    "ipaddr.js": "2.4.0",
    "mysql2": "3.23.2",
    "neo4j-driver": "6.2.0",
    "node-sql-parser": "5.4.0",
    "pg": "8.22.0",
    "pgsql-parser": "18.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
