{
  "name": "@data-agent/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./artifact-workspace-service": {
      "types": "./dist/artifacts/artifact-workspace-service.d.ts",
      "import": "./dist/artifacts/artifact-workspace-service.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./authz": {
      "types": "./dist/authz/index.d.ts",
      "import": "./dist/authz/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./datasource-adapters": {
      "types": "./dist/datasources/adapters/index.d.ts",
      "import": "./dist/datasources/adapters/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "import": "./dist/jobs/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "import": "./dist/knowledge/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./research": {
      "types": "./dist/research/index.d.ts",
      "import": "./dist/research/index.js"
    },
    "./runs": {
      "types": "./dist/runs/index.d.ts",
      "import": "./dist/runs/index.js"
    },
    "./runtime-config": {
      "types": "./dist/runtime-config/index.d.ts",
      "import": "./dist/runtime-config/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "import": "./dist/secrets/index.js"
    },
    "./semantic-postgres": {
      "types": "./dist/semantic-postgres/index.d.ts",
      "import": "./dist/semantic-postgres/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./tenancy": {
      "types": "./dist/tenancy/index.d.ts",
      "import": "./dist/tenancy/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run test --exclude 'test/integration/**'",
    "test:contract": "vitest run test/contract",
    "test:integration": "vitest run test/integration --passWithNoTests=false",
    "test:tenancy": "vitest run test/tenancy test/storage test/cache test/lifecycle --passWithNoTests=false",
    "test:security": "vitest run test/datasources test/secrets test/tenancy test/storage test/cache --passWithNoTests=false"
  },
  "dependencies": {
    "@clickhouse/client": "1.20.0",
    "@data-agent/contracts": "workspace:*",
    "@duckdb/node-api": "1.5.2-r.2",
    "@next/env": "16.3.0",
    "@upstash/redis": "1.38.0",
    "ipaddr.js": "2.4.0",
    "mysql2": "3.23.2",
    "neo4j-driver": "6.2.0",
    "node-sql-parser": "5.4.0",
    "pg": "8.22.0",
    "pgsql-parser": "18.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
