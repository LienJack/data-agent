{
  "name": "@data-agent/research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm build && vitest run test --exclude 'test/architecture.spec.ts' --exclude 'test/performance-budget.spec.ts' --testTimeout=30000 --maxWorkers=2 --passWithNoTests=false",
    "test:research": "pnpm build && vitest run test --testTimeout=30000 --maxWorkers=2 --passWithNoTests=false",
    "test:architecture": "pnpm build && vitest run test/architecture.spec.ts --passWithNoTests=false"
  },
  "dependencies": {
    "@data-agent/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
