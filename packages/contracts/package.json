{
  "name": "@data-agent/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./datasources": {
      "types": "./dist/datasources/index.d.ts",
      "import": "./dist/datasources/index.js"
    },
    "./evals": {
      "types": "./dist/evals/index.d.ts",
      "import": "./dist/evals/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./runs": {
      "types": "./dist/runs/index.d.ts",
      "import": "./dist/runs/index.js"
    },
    "./semantic": {
      "types": "./dist/public/semantic.d.ts",
      "import": "./dist/public/semantic.js"
    },
    "./statistical-operators": {
      "types": "./dist/generated/statistical-operators.d.ts",
      "import": "./dist/generated/statistical-operators.js"
    },
    "./workspaces": {
      "types": "./dist/workspaces/index.d.ts",
      "import": "./dist/workspaces/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm check:statistical-operators && tsc -p tsconfig.build.json",
    "typecheck": "pnpm check:statistical-operators && tsc -p tsconfig.json --noEmit",
    "check:statistical-operators": "tsx ../../scripts/generate-statistical-operator-contracts.ts --check",
    "test:unit": "vitest run test --testTimeout=15000",
    "test:contract": "vitest run test/port-conformance.spec.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
